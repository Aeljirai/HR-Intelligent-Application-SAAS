# Used by docker-compose.yml to build and run all three containers
# (frontend, backend, ml-service) against your existing Supabase Cloud
# project — same values as backend/.env.example and frontend/.env.example.
# Copy to `.env` in this directory and fill in, then run:
#   docker compose up --build
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Powers the RAG policy co-pilot via a local Ollama server running on the
# host (install from ollama.com, then `ollama pull llama3.1`). If Ollama
# isn't reachable, the endpoint returns a clean 503 instead of failing to
# start.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# Demo seed accounts (used only by `docker compose exec backend bun run seed`)
SEED_ADMIN_PASSWORD=Admin123!
SEED_EMPLOYEE_PASSWORD=Employee123!

# n8n daily HR report automation (see n8n/README.md)
HR_ADMIN_EMAIL=hr-admin@company.com
SMTP_FROM_EMAIL=hr-automation@company.com
