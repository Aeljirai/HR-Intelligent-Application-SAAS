# Used by docker-compose.yml to build and run all three containers
# (frontend, backend, ml-service) against your existing Supabase Cloud
# project — same values as backend/.env.example and frontend/.env.example.
# Copy to `.env` in this directory and fill in, then run:
#   docker compose up --build
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Powers the RAG policy co-pilot via a local Ollama server. Install Ollama
# and pull a model first (e.g. `ollama pull deepseek-r1:8b`), then match
# OLLAMA_MODEL to the tag `ollama list` shows. From inside Docker Compose,
# OLLAMA_BASE_URL must point at the host, not the container network — see
# docker-compose.yml. If Ollama is unreachable or the model isn't pulled,
# the endpoint returns a clean 503 instead of failing to start.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# Demo seed accounts (used only by `docker compose exec backend bun run seed`)
SEED_ADMIN_PASSWORD=Admin123!
SEED_EMPLOYEE_PASSWORD=Employee123!

# n8n daily HR report automation (see n8n/README.md)
HR_ADMIN_EMAIL=hr-admin@company.com
SMTP_FROM_EMAIL=hr-automation@company.com
