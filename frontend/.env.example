# Same Supabase project as the backend — the frontend only ever uses the
# public anon key (Row Level Security protects the data; see supabase/migrations).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Node/Express API (see backend/). In dev, Vite proxies /api to this URL (vite.config.ts).
VITE_API_BASE_URL=http://localhost:4000
